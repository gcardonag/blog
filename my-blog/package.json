    "gatsby-plugin-typography": "^5.14.0",
    "gatsby-remark-graph": "^0.2.2",
    "gatsby-source-filesystem": "^5.14.0",
    "gatsby-transformer-remark": "^6.14.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-typography": "^0.16.19",
    "typography": "^0.16.19",
    "typography-theme-kirkham": "^0.16.19"
  },
  "devDependencies": {
    "prettier": "^3.6.2"
  },
  "comment:resolutions": [
    "Forced versions for transitive dependencies with published security",
    "advisories that their parents' declared ranges pin below the fix.",
    "sanitize-html is held at 2.17.5 (last release that clears GHSA-vccv-cmxp-4j9h",
    "without requiring node >=22.12, which the build image does not guarantee).",
    "file-type is knowingly left at 16.x: the fix (>=21.3.1) is ESM-only and",
    "cannot load in this CommonJS build. It is build-time only and never shipped."
  ],
  "resolutions": {
    "@parcel/reporter-dev-server": "^2.16.4",
    "cookie": "^0.7.2",
    "immutable": "^4.3.9",
    "lodash": "^4.18.1",
    "path-to-regexp": "^0.1.13",
    "sanitize-html": "2.17.5",
    "serialize-javascript": "^7.1.0",
    "sharp": "^0.35.3",
    "tmp": "^0.2.7",
    "uuid": "^11.1.1",
    "webpack": "^5.109.2"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/gcardonag/blog"
  },
  "bugs": {
