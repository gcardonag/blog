  "description": "Created from gatsby-starter-hello-world",
  "version": "0.1.0",
  "license": "MIT",
  "scripts": {
    "build": "gatsby build",
    "deploy": "gatsby-plugin-s3 deploy",
    "develop": "gatsby develop",
    "format": "prettier --write \"**/*.{js,jsx,json,md}\"",
    "start": "npm run develop",
    "serve": "gatsby serve",
    "test": "gatsby build && node --test test/",
    "test:only": "node --test test/"
  },
  "dependencies": {
    "@emotion/react": "^11.14.0",
